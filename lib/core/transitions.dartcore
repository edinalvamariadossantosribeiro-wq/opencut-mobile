String getTransitionFFmpeg(String transitionName, double duration) {
  final transition = transitionPresets.firstWhere(
    (t) => t["name"] == transitionName,
    orElse: () => transitionPresets[0],
  );
  return transition["ffmpeg"] as String;
}

